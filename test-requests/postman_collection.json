							"host": [ "[[baseUrl]]" ],
							"path": [ "test", "public" ]
						}
					}
				},
				{
					"name": "Authenticated Endpoint",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/test/authenticated",
							"host": [ "[[baseUrl]]" ],
							"path": [ "test", "authenticated" ]
						}
					}
				},
