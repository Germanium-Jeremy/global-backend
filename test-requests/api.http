### API Gateway Base URL
@baseUrl = http://localhost:3000

### 1. Register a new Admin User
# @name registerAdmin
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123",
  "role": "admin"
}

### 2. Login as Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "password123"
}

### 3. Register a Standard User
# @name registerStandard
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123",
  "role": "standard"
}

### 4. Login as Standard User
# @name loginStandard
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "password123"
}


### ---------------- Testing Service Endpoints ----------------

### 5. Public Endpoint
GET {{baseUrl}}/test/public

### 6. Authenticated Endpoint (Using Standard Token)
GET {{baseUrl}}/test/authenticated
Authorization: Bearer {{loginStandard.response.body.token}}

### 7. Admin Only Endpoint (Fails with Standard Token)
GET {{baseUrl}}/test/admin
Authorization: Bearer {{loginStandard.response.body.token}}

### 8. Admin Only Endpoint (Succeeds with Admin Token)
GET {{baseUrl}}/test/admin
Authorization: Bearer {{loginAdmin.response.body.token}}

### 9. Staff or Admin Endpoint (Succeeds with Admin Token)
GET {{baseUrl}}/test/staff-or-admin
Authorization: Bearer {{loginAdmin.response.body.token}}


### ---------------- AI Service Endpoints ----------------

### 10. Get Custom Instructions
GET {{baseUrl}}/ai/instructions
Authorization: Bearer {{loginStandard.response.body.token}}

### 11. Update Custom Instructions
PUT {{baseUrl}}/ai/instructions
Authorization: Bearer {{loginStandard.response.body.token}}
Content-Type: application/json

{
  "systemPrompt": "You are a helpful AI assistant who speaks like a pirate."
}

### 12. Full AI Chat Response
# @name aiChat
POST {{baseUrl}}/ai/chat
Authorization: Bearer {{loginStandard.response.body.token}}
Content-Type: application/json

{
  "prompt": "What is the capital of France?",
  "model": "llama3.2:3b"
}

### 13. Streaming AI Chat Response
POST {{baseUrl}}/ai/chat/stream
Authorization: Bearer {{loginStandard.response.body.token}}
Content-Type: application/json

{
  "prompt": "Tell me a long story about a brave knight.",
  "model": "llama3.2:3b"
}

### 14. Create a New Chat Thread
# @name createChat
POST {{baseUrl}}/ai/chats
Authorization: Bearer {{loginStandard.response.body.token}}
Content-Type: application/json

{
  "title": "My first AI conversation"
}

### 15. List All Chats
GET {{baseUrl}}/ai/chats
Authorization: Bearer {{loginStandard.response.body.token}}

### 16. Get a Specific Chat
GET {{baseUrl}}/ai/chats/{{createChat.response.body._id}}
Authorization: Bearer {{loginStandard.response.body.token}}

### 17. Send Message to Specific Chat
POST {{baseUrl}}/ai/chats/{{createChat.response.body._id}}/message
Authorization: Bearer {{loginStandard.response.body.token}}
Content-Type: application/json

{
  "content": "Hello! How can you help me today?",
  "model": "llama3.2:3b"
}
